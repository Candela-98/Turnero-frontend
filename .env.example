# URL privada del backend. Nunca usar NEXT_PUBLIC_ para esta variable.
TURNERO_API_BASE_URL=http://localhost:8080

# Origen exacto del frontend en el navegador. Cambiar si se usa otro host o puerto.
TURNERO_FRONTEND_ORIGIN=http://localhost:3000

# Necesaria cuando se implemente TURN-69 (Google Identity Services).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
